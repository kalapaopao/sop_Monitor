{
  "title": "重复 SOP 片段核对",
  "provenance": "Qwen 候选经 Codex 画面复核",
  "note": "每类展示两个视频各两个周期。时间为近似支持窗口。",
  "steps": [
    {
      "id": "C1",
      "display_name": "部件预处理",
      "observable_definition": "在夹具前方取用、翻转、对合或局部处理银灰与黑色部件；代表周期中白布定位座尚未装入带线壳体。"
    },
    {
      "id": "C2",
      "display_name": "带线壳体上夹具",
      "observable_definition": "从后方取来较大的黑色带线壳体，置于中央白布包围的定位座。"
    },
    {
      "id": "C3",
      "display_name": "银灰部件入壳定位",
      "observable_definition": "将银灰结构件移向已经在定位座内的黑色壳体，进行放入、对合及局部线束/位置整理。"
    },
    {
      "id": "C4",
      "display_name": "夹具内紧固作业",
      "observable_definition": "悬挂式工具反复接触夹具内工件，期间可伴随从蓝色料盒取小件。"
    },
    {
      "id": "C5",
      "display_name": "收尾下料",
      "observable_definition": "悬挂工具离开后做局部整理，将组合件提离定位座并向后方传送带移交，定位座重新露空。"
    }
  ],
