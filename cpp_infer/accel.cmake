# Opt-in executable; the old targets and defaults remain available.
find_package(PkgConfig REQUIRED)
pkg_check_modules(ACCEL_MEDIA REQUIRED IMPORTED_TARGET libavformat libavutil libswscale)
include_directories(${CMAKE_CURRENT_SOURCE_DIR}/src ${CUDA_INCLUDE_DIRS})
cuda_add_library(sop_preprocess STATIC src/accel_preprocess.cu OPTIONS -std=c++14
    -gencode=arch=compute_72,code=sm_72 -gencode=arch=compute_72,code=compute_72)
target_link_libraries(sop_preprocess ${CUDA_CUDART_LIBRARY})
foreach(accel_target sop_nx_accel_probe accel_preprocess_test accel_model_test)
    if(accel_target STREQUAL "sop_nx_accel_probe")
        set(accel_source src/accel_probe.cpp)
    elseif(accel_target STREQUAL "accel_preprocess_test")
        set(accel_source tests/accel_preprocess_test.cpp)
    else()
        set(accel_source tests/accel_model_test.cpp)
    endif()
    add_executable(${accel_target} ${accel_source})
    target_include_directories(${accel_target} PRIVATE src ${OpenCV_INCLUDE_DIRS} ${CUDA_INCLUDE_DIRS} ${TENSORRT_INCLUDE_DIR})
    target_link_libraries(${accel_target} PRIVATE sop_preprocess sop_silu_plugin ${OpenCV_LIBS}
        ${TENSORRT_LIBRARY} ${TENSORRT_PLUGIN_LIBRARY} Threads::Threads ${CUDA_CUDART_LIBRARY})
    target_compile_options(${accel_target} PRIVATE -Wall -Wextra -O3)
endforeach()
target_link_libraries(sop_nx_accel_probe PRIVATE PkgConfig::ACCEL_MEDIA)
add_executable(accel_decode_test tests/accel_decode_test.cpp)
target_include_directories(accel_decode_test PRIVATE src ${OpenCV_INCLUDE_DIRS})
target_link_libraries(accel_decode_test PRIVATE ${OpenCV_LIBS} PkgConfig::ACCEL_MEDIA)
if(BUILD_TESTING)
    add_test(NAME accel_preprocess COMMAND accel_preprocess_test)
    set_tests_properties(accel_preprocess PROPERTIES TIMEOUT 30)
endif()
